# ==========================================
# SkillSync Full-Stack Environment Variables
# ==========================================

# Application Environment (development | production)
NODE_ENV=development

# Backend Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas Cluster)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skillsync?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillsync

# JSON Web Token Secret for Authentication (Change this in production to a high-entropy string)
JWT_SECRET=skillsync_super_secure_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS and Socket.IO Handshake
CLIENT_URL=http://localhost:5173

# Directory where uploaded PDF resumes are securely stored on disk
UPLOAD_DIR=./uploads

# Optional Google OAuth Client ID (for future Google Sign-in integration)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
